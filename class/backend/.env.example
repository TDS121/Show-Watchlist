# Copy this file to .env and fill it in:   cp .env.example .env
# .env is in .gitignore, so your secrets never go to GitHub.

PORT=3000
# development on your laptop, production on the server (turns on Secure cookies)
NODE_ENV=development
DB_CONNECT=mongodb://localhost:27017/watchlist

# A long random string that signs the login cookie. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
